# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=True
# URL e host públicos canônicos usados em redirects, SEO, sitemap e robots.
SITE_URL=https://mundodainformatica.com
CANONICAL_HOST=mundodainformatica.com
SUPPORT_EMAIL=suporte@mundodainformatica.com
# Em produção com mais de um processo, use Redis: redis://host:6379/0
RATELIMIT_STORAGE_URI=memory://

# Database Configuration (SQLite atual ou PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database
# Para desenvolvimento local: sqlite:///instance/site.db

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Upload Configuration
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=67108864

# Motor de conteúdo técnico (incremental)
TECHNICAL_IMPORT_ENABLED=True
TECHNICAL_CONTRIBUTIONS_ENABLED=True
TECHNICAL_IMPORT_TEMP_DIR=instance/technical-imports
TECHNICAL_LOCAL_STORAGE_DIR=instance/technical-files

# Entrega interna: use proxy em produção. "redirect" existe apenas para
# rollback temporário de links legados e expõe o domínio do storage.
DOWNLOAD_DELIVERY_MODE=proxy
STORAGE_CONNECT_TIMEOUT=5
STORAGE_READ_TIMEOUT=45
# Vazio aceita qualquer host HTTP(S) público e bloqueia redes privadas (SSRF).
# Para allowlist estrita, separe domínios por vírgula; subdomínios são aceitos.
STORAGE_ALLOWED_HOSTS=
# Exemplo de allowlist estrita:
# STORAGE_ALLOWED_HOSTS=mediafire.com,dl.dell.com,downloads.dell.com

# Feeds JSON oficiais/licenciados opcionais (nunca use páginas raspadas).
# O catálogo público da Dell é CAB e não deve ser colocado neste campo:
# use um worker autorizado que o converta para o feed JSON normalizado.
DELL_CATALOG_URL=
DELL_CATALOG_TOKEN=
HP_CATALOG_URL=
HP_CATALOG_TOKEN=
LENOVO_CATALOG_URL=
LENOVO_CATALOG_TOKEN=
LICENSED_FEED_URL=
LICENSED_FEED_TOKEN=
TECHNICAL_SYNC_DELL_PART_NUMBERS=
TECHNICAL_SYNC_HP_PART_NUMBERS=
TECHNICAL_SYNC_LENOVO_PART_NUMBERS=
TECHNICAL_SYNC_FEED_LICENCIADO_PART_NUMBERS=

# Motor multi-fonte de datasheets
# O motor pode funcionar em modo semiautomático. Autopublicação e HTML
# discovery permanecem bloqueados até serem habilitados também no painel.
ENABLE_DATASHEET_ENGINE=True
ENABLE_DATASHEET_AUTO_PUBLISH=False
DISABLE_ALL_DATASHEET_AUTOMATION=False
ENABLE_SOURCE_PARTS=True
ENABLE_ALLDATASHEET_API=False
ENABLE_ALLDATASHEET_HTML=False
ENABLE_DATASHEETS_COM_API=False
ENABLE_DATASHEETS_COM_HTML=False

# Source Parts: https://source.parts/dashboard/api/keys
SOURCE_PARTS_API_URL=https://api.source.parts/v1
SOURCE_PARTS_API_KEY=
# Identifique aplicação e contato, conforme exigido pela documentação.
SOURCE_PARTS_USER_AGENT=MundoDaInformatica/1.0 (contato: suporte@mundodainformatica.com)

# AllDatasheet: URL/header/parâmetro são fornecidos individualmente após
# aprovação. Não invente valores; a key sozinha não configura a API.
ALLDATASHEET_API_KEY=
ALLDATASHEET_API_URL=
ALLDATASHEET_API_AUTH_HEADER=
ALLDATASHEET_API_QUERY_PARAMETER=

# Datasheets.com Product Search API: https://www.datasheets.com/api-docs
DATASHEETS_COM_API_URL=https://www.datasheets.com/api/v1/search
DATASHEETS_COM_API_KEY=

# HTML discovery é opt-in e exige permissão escrita registrada no painel,
# robots.txt permitido e template autorizado contendo {part_number}.
DATASHEET_DISCOVERY_USER_AGENT=MundoDaInformatica/1.0 (contato: suporte@mundodainformatica.com)
ALLDATASHEET_HTML_SEARCH_URL=
DATASHEETS_COM_HTML_SEARCH_URL=

# Feeds oficiais/licenciados opcionais, conforme contrato do parceiro.
MANUFACTURER_DATASHEET_FEED_URL=
MANUFACTURER_DATASHEET_FEED_TOKEN=
LICENSED_DATASHEET_FEED_URL=
LICENSED_DATASHEET_FEED_TOKEN=

# Fila/jobs. A sincronização não processa consultas por padrão.
DATASHEET_SYNC_PART_NUMBERS=
DATASHEET_SYNC_DEMAND_LIMIT=20
DATASHEET_SYNC_RESOURCE_LIMIT=100
DATASHEET_SYNC_PROCESS=False
DATASHEET_QUEUE_JOB_LIMIT=25
# Restrinja os hosts de PDF autorizados em produção.
DATASHEET_STORAGE_ALLOWED_HOSTS=

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRODUCT_PREMIUM=prod_...
STRIPE_PRODUCT_VIP=prod_...
# 🆕 Webhook Secret - OBRIGATÓRIO para processar pagamentos automaticamente
# Obtenha em: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Abacate Pay (sem valores padrão no código)
ABACATEPAY_API_URL=https://api.abacatepay.com/v2
ABACATEPAY_API_KEY=
ABACATEPAY_PUBLIC_KEY=
ABACATEPAY_WEBHOOK_SECRET=

# Firebase / Google Sign-In
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Escolha uma das opções abaixo para o Firebase Admin:
# 1) caminho no filesystem (Render: monte como Secret File)
FIREBASE_SERVICE_ACCOUNT_PATH=
# 2) JSON completo em linha única
FIREBASE_SERVICE_ACCOUNT_JSON=
# 3) JSON do service account em Base64 (recomendado para Render)
FIREBASE_SERVICE_ACCOUNT_B64=

# Meta (Facebook) Conversions API - token de acesso gerado no Gerenciador de Eventos
META_PIXEL_ID=
META_ACCESS_TOKEN=

# Cloudinary (opcional; uploads locais continuam disponíveis)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
